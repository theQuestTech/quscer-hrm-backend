# Postgres connection (Supabase, matching the rest of Quscer's infra)
DATABASE_URL="postgresql://user:password@localhost:5432/quscer_hrm?schema=public"

# App
PORT=4100
NODE_ENV=development

# JWT — standalone for now. Once connected to Quscer OS (WBS 6.1), this
# should be replaced with shared token validation against the OS's auth
# service instead of issuing its own tokens.
JWT_SECRET="replace-with-a-real-secret"
JWT_EXPIRES_IN="1d"

# WBS 6.12 — encrypts bank account numbers at rest. 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it once real data is stored: rows encrypted
# with a lost key cannot be read back.
FIELD_ENCRYPTION_KEY=""

# Allowed browser origins for the HRM frontend, comma-separated.
CORS_ORIGINS="http://localhost:3000"
